# PMAS Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# Database (Supabase, Render, or local PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/pmas

# JWT Security
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRY_HOURS=24

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-pmas-domain.netlify.app

# Server
HOST=0.0.0.0
PORT=8000
